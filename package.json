{
  "name": "alchyx",
  "version": "0.1.0",
  "private": true,
  "description": "Alchyx — D-ALabs' Ultimate Design System. One coherent React + TypeScript library on the D-ALabs Lab/Dark/Ark design language, consolidating the best of eight MIT design systems.",
  "license": "MIT",
  "author": "D-ALabs, LLC",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playground": "pnpm --filter @alchyx/playground dev",
    "build:playground": "pnpm --filter @alchyx/playground build",
    "build": "pnpm --filter @alchyx/tokens build && pnpm --filter @alchyx/react build"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.33.0"
}
