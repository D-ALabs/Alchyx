{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@alchyx/tokens": ["packages/tokens/src/index.ts"],
      "@alchyx/tokens/*": ["packages/tokens/src/*"],
      "@alchyx/react": ["packages/react/src/index.ts"],
      "@alchyx/react/*": ["packages/react/src/*"]
    }
  },
  "include": [
    "packages/tokens/src",
    "packages/react/src",
    "apps/playground/src",
    "apps/playground/vite.config.ts"
  ]
}
