{
  "name": "@alchyx/tokens",
  "version": "0.1.0",
  "description": "Alchyx design tokens — the D-ALabs Lab/Dark/Ark language as CSS variables, typed JS tokens, and a Tailwind preset.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tailwind": {
      "types": "./src/tailwind-preset.ts",
      "default": "./src/tailwind-preset.ts"
    },
    "./css": "./src/css/index.css",
    "./css/*": "./src/css/*"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsup src/index.ts src/tailwind-preset.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
