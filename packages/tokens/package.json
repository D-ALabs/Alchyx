{
  "name": "@alchyx/tokens",
  "version": "0.2.0-beta.1",
  "description": "Alchyx design tokens — the D-ALabs Lab/Dark/Ark language as CSS variables, typed JS tokens, and a Tailwind preset.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs",
      "default": "./dist/tailwind-preset.js"
    },
    "./css": "./dist/css/index.css",
    "./css/*": "./dist/css/*",
    "./tailwind.css": "./dist/css/tailwind.css"
  },
  "files": ["src", "dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/tailwind-preset.ts --format esm,cjs --dts --clean && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:contracts": "node scripts/check-contract.mjs",
    "check": "pnpm run build && pnpm run check:contracts",
    "test": "pnpm run check",
    "prepack": "pnpm run check"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
